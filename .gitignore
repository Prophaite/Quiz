public/musique-attente.*

# Variables d'environnement / mots de passe
.env
.env.*

# Fichiers temporaires d'Excel et du système
~$*
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/

# Réglages locaux de Claude Code (launch.json reste suivi)
.claude/settings.local.json
